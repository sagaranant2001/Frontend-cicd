{
    "family":  "frontend-task",
    "networkMode":  "awsvpc",
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "256",
    "memory":  "512",
    "executionRoleArn":  "arn:aws:iam::000000000000:role/frontend-task-execution-role",
    "containerDefinitions":  [
                                 {
                                     "name":  "frontend",
                                     "image":  "localhost:5100/frontend-repo:latest",
                                     "portMappings":  [
                                                          {
                                                              "containerPort":  80,
                                                              "hostPort":  80,
                                                              "protocol":  "tcp"
                                                          }
                                                      ],
                                     "essential":  true,
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/frontend",
                                                                              "awslogs-region":  "us-east-1",
                                                                              "awslogs-stream-prefix":  "frontend"
                                                                          }
                                                          }
                                 }
                             ]
}
